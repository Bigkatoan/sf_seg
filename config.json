{
  "data_root": "data",
  "epochs": 400,
  "batch_size": 32,
  "lr": 1e-4,
  "num_workers": 8,
  "log_dir": "logs",
  "output_dir": "outputs",
  "checkpoint_dir": "checkpoints",
  "loss_type": "focal_iou",
  "image_size": 224,
  "num_channels": 128,
  "focus_size": 28,
  "encoder_stride": 1,
  "diversity_weight": 0.1,
  "num_classes": 151,
  "absent_weight": 0.2,
  "attn_guide_weight": 0.0,
  "attn_exclusive_weight": 0.0,
  "decoder_type": "dense",
  "class_diverse": false,
  "resume": true,
  "restart": true,
  "iou_w": 0.5,
  "backbone": "custom",
  "freeze_backbone": false,
  "boundary_weight": 0.3,
  "edge_weight": 4.0,
  "corner_weight": 6.0,
  "aug_hflip": true,
  "aug_resized_crop": true,
  "aug_color_jitter": true,
  "aug_gaussian_noise": false,
  "aug_cutout": true,
  "aug_shift": true
}
