{
  "model_type": "v2",
  "backbone_variant": "micro",
  "dw_kernel": 3,
  "num_channels": 32,
  "focus_size": 64,
  "num_classes": 150,
  "decoder_type": "dense",
  "decoder_dim": 256,
  "hr_dim": 96,
  "grad_checkpoint": false,
  "attn_masks": [16, 8, 8],
  "budget_ladder": true,
  "pos_encode": true,

  "data_root": "data",
  "image_size": 512,
  "batch_size": 14,
  "accum_steps": 4,
  "epochs": 200,
  "num_workers": 4,

  "lr": 1e-3,
  "lr_schedule": "constant",
  "backbone_lr_factor": 1.0,
  "grad_clip": 5.0,

  "iou_w": 1.0,
  "iou_downsample": 4,
  "iou_warm_epochs": 10,
  "no_obj_weight": 0.1,
  "boundary_weight": 1.0,
  "diversity_weight": 0.3,
  "edge_weight": 0.0,
  "attn_guide_weight": 0.0,
  "attn_exclusive_weight": 0.0,
  "aux_weight": 0.4,
  "presence_weight": 0.4,
  "presence_pos_weight": 4.0,

  "aug_hflip": true,
  "aug_resized_crop": true,
  "aug_color_jitter": false,
  "aug_hue": false,
  "aug_cutout": false,
  "aug_shift": true,

  "class_aware_sampler": true,

  "vis_interval": 10,
  "vis_samples": 6,

  "log_dir": "logs",
  "output_dir": "outputs",
  "checkpoint_dir": "checkpoints",
  "resume": false
}
